{
  "expo": {
    "name": "Dal",
    "slug": "dal-app-ropa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8F7F4",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dal.appropa",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8F7F4"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#1A1918"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
